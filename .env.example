AA_ENV=development
AA_DEBUG=false
AA_DATA_DIR=data
AA_LOG_DIR=logs
AA_CONFIG_DIR=config
AA_TEMP_DIR=.tmp

AA_LOG_LEVEL=INFO
AA_LOG_CONSOLE_ENABLED=true
AA_LOG_FILE_ENABLED=false
AA_LOG_FORMAT=text
AA_LOG_FILE_NAME=aa-crawler.log
AA_LOG_MAX_BYTES=10485760
AA_LOG_BACKUP_COUNT=5

# Optional future infrastructure
# AA_HTTP_PROXY=
# AA_HTTPS_PROXY=
