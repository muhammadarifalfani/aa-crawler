# Normalize automatically detected text files and check them out with LF.
* text=auto eol=lf

# Python
*.py      text eol=lf
*.pyi     text eol=lf

# Documentation and plain text
*.md      text eol=lf
*.rst     text eol=lf
*.txt     text eol=lf

# Configuration and structured data
*.cfg     text eol=lf
*.conf    text eol=lf
*.ini     text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.xml     text eol=lf
*.lock    text eol=lf
.env*     text eol=lf

# Shell scripts
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf

# Common extensionless text files
Dockerfile text eol=lf
Makefile   text eol=lf

# Text-based image formats
*.svg     text eol=lf

# Raster images
*.bmp     binary
*.gif     binary
*.ico     binary
*.jpeg    binary
*.jpg     binary
*.png     binary
*.webp    binary

# Documents and PDFs
*.doc     binary
*.docx    binary
*.pdf     binary
*.ppt     binary
*.pptx    binary
*.xls     binary
*.xlsx    binary

# Archives and compressed files
*.7z      binary
*.bz2     binary
*.gz      binary
*.rar     binary
*.tar     binary
*.tgz     binary
*.xz      binary
*.zip     binary

# Fonts
*.eot     binary
*.otf     binary
*.ttf     binary
*.woff    binary
*.woff2   binary

# Databases and compiled Python files
*.db      binary
*.pyc     binary
*.sqlite  binary
*.sqlite3 binary
